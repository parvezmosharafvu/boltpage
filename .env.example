# Placeholders only. Never commit real values. See docs/SECRETS.md for where each one lives.

# --- Public (safe in the browser; written to public/config.js by `npm run config`) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public-anon-key>
BRAND_NAME=Boltpage

# --- Supabase Edge Function secrets (`supabase secrets set ...`) ---
SUPABASE_SERVICE_ROLE_KEY=<secret>          # injected automatically in hosted functions; never in public/
LND_REST_URL=https://<lnd-tunnel-hostname>  # Cloudflare Tunnel hostname in front of LND REST
LND_INVOICE_MACAROON_HEX=<secret>           # invoice-only macaroon, hex encoded
CF_ACCESS_CLIENT_ID=<secret>
CF_ACCESS_CLIENT_SECRET=<secret>
TELEGRAM_BOT_TOKEN=<secret>
TELEGRAM_WEBHOOK_SECRET=<secret>
CRON_SECRET=<secret>
IP_HASH_SALT=<secret>                       # salts client IP hashes used for rate limiting

# --- CI / deploy only ---
CLOUDFLARE_API_TOKEN=<secret>

# --- Local tests only ---
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres   # empty database for npm run test:sql
