// Static site Worker: serves public/ with extensionless HTML.
// Unknown paths fall through to public/404.html, which resolves /<slug> and /pay/<slug> client-side.
{
  "name": "boltpage-site",
  "compatibility_date": "2025-10-01",
  // Served only on the custom domains below (a workers.dev copy would bypass the preview Worker).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Attach every hostname listed in public.site_domains.
  "routes": [
    { "pattern": "usa-cash.app", "custom_domain": true }
  ]
}
